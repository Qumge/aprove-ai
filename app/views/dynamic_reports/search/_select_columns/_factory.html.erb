      <h3 class="box-title"><%= t('sections.dynamic_reports.fields.factory') %></h3>
      <!-- /.box-tools -->
    </div>
    <!-- /.box-header -->
    <div class="box-body" style="display: block;">
      <div class="checkbox">
        <label>
          <input type="checkbox" value="factories.name" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.factory_name') %>
        </label>
      </div>
      <div class="checkbox">
        <label>
          <input type="checkbox" value="factories.address" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.factory_address') %>
        </label>
      </div>

    </div>
    <!-- /.box-body -->
  </div>
  <!-- /.box -->
</div>
