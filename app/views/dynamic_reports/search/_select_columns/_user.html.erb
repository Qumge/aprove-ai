<div class="col-md-3">
  <div class="box box-default box-solid">
    <div class="box-header with-border">
      <h3 class="box-title"><%= t('sections.dynamic_reports.fields.salesperson') %></h3>
      <!-- /.box-tools -->
    </div>
    <!-- /.box-header -->
    <div class="box-body" style="display: block;">
      <div class="checkbox">
        <label>
          <input type="checkbox" value="users.login" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.account') %>
        </label>
      </div>
      <div class="checkbox">
        <label>
          <input type="checkbox" value="users.name" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.name') %>
        </label>
      </div>
      <div class="checkbox">
        <label>
          <input type="checkbox" value="users.email" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.email') %>
        </label>
      </div>
      <div class="checkbox">
        <label>
          <input type="checkbox" value="users.title" name="select_columns[]">
          <%= t('sections.dynamic_reports.fields.title') %>
        </label>
      </div>

    </div>
    <!-- /.box-body -->
  </div>
  <!-- /.box -->
</div>
