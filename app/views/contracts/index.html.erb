<%= render 'contracts/header' %>

<div class="row">
  <div class="col-md-12">
    <div class="box">
      <%= form_tag contracts_path, method: :get do%>
      <div class="box-header with-border">
        <h3 class="box-title"><%= t('sections.contracts.list') %></h3>
        <% if can? :new, :contracts%>
        <%= link_to t('sections.contracts.add'), new_contract_path, class: 'font-a label pull-right bg-green', style: 'font-size: 100%' %>
        <% end %>
      </div>
      <div class="box-tools">
        <div class="input-group input-group-sm">
          <div class="pull-right">
            <div class="col-xs-12">
              <input type="text" name="table_search" class="form-control" placeholder="<%= t('common.search') %>" value="<%= params[:table_search] %>">
            </div>
          </div>

          <div class="input-group-btn">
            <button type="submit" class="btn btn-default icon-button" title="<%= t('common.search') %>"><%= ui_icon 'search' %></button>
          </div>
        </div>
      </div>
        <% end %>
      <!-- /.box-header -->
      <div class="box-body">
        <table class="table table-bordered">
          <tr>
            <th><%= t('sections.contracts.columns.number') %></th>
            <th><%= t('sections.contracts.columns.details') %></th>
            <th><%= t('sections.contracts.columns.partner') %></th>
            <th><%= t('sections.contracts.columns.validity') %></th>
            <th></th>
          </tr>
          <% if @contracts.present? %>
            <% @contracts.each do |contract| %>
              <tr>
                <td><%= link_to contract.no, contract_path(contract) %></td>
                <td><%= contract.name %></td>
                <td><%= contract.partner %></td>
                <td><%= simple_time contract.valid_date %></td>
                <td>
                  <% if can? :edit, :contracts%>
                    <%= link_to  edit_contract_path(contract), class: 'label label-success' do %>
                      <%= ui_icon 'pencil' %><%= t('common.edit') %>
                    <% end %>
                  <% end %>

                  <%#= link_to contract_path(contract), method: :delete, data: {confirm: '确定删除吗？'}, class: 'label label-danger' do %>
<!--                    <i class="fa fa-close"></i>删除-->
                  <%# end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" align="center"><%= t('common.empty') %></td>
            </tr>
          <% end %>

        </table>
      </div>
      <!-- /.box-body -->
      <div class="box-footer clearfix">
        <div class="pull-right pagination-sm no-margin">
          <%= paginate @contracts%>
        </div>

      </div>
    </div>
    <!-- /.box -->
  </div>
</div>
