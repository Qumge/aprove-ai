<%= render 'audits/header' %>
<div class="row">
  <div class="col-md-12">
    <div class="box">
      <div class="box-header with-border">
        <h3 class="box-title"><%= t('sections.audits.pending_project') %></h3>
      </div>
      <!-- /.box-header -->
      <div class="box-body">
        <table class="table table-bordered">
          <tr>
            <th><%= t('sections.audits.columns.project') %></th>
            <th><%= t('sections.audits.columns.project_creator') %></th>
            <th><%= t('sections.audits.columns.created_at') %></th>
            <th></th>
          </tr>
          <% if @projects.present? %>
            <% @projects.each do |project| %>
              <tr>
                <td><%= link_to project.name, project_path(project) %></td>
                <td><%= project.create_user.name %></td>
                <td><%= simple_time project.created_at %></td>
                <td>
                  <%= link_to t('sections.audits.approve'), success_audit_path(project, type: project.class.name), class: 'btn btn-success btn-xs', data: {confirm: t('sections.audits.confirm_approve')} %>
                  <%= link_to t('sections.audits.reject'), failed_notice_audit_path(project, type: project.class.name), 'data-toggle' => "modal", 'data-target' => "#global-modal", class: 'btn btn-danger btn-xs' %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" align="center"><%= t('sections.audits.none') %></td>
            </tr>
          <% end %>

        </table>
      </div>
      <!-- /.box-body -->
      <div class="box-footer clearfix">
        <div class="pull-right pagination-sm no-margin">
          <%= paginate @projects%>
        </div>

      </div>
    </div>
    <!-- /.box -->
  </div>
</div>
