<%= render 'audits/header' %>
<div class="row">
  <div class="col-md-12">
    <div class="box">
      <div class="box-header with-border">
        <h3 class="box-title"><%= t('sections.audits.pending_sample') %></h3>
      </div>
      <!-- /.box-header -->
      <div class="box-body">
        <table class="table table-bordered">
          <tr>
            <th><%= t('sections.audits.columns.project') %></th>
            <th><%= t('sections.audits.columns.order_number') %></th>
            <th><%= t('sections.audits.columns.applicant') %></th>
            <th><%= t('sections.audits.columns.owner') %></th>
            <th><%= t('sections.audits.columns.applied_at') %></th>
            <th></th>
          </tr>
          <% if @orders.present? %>
            <% @orders.each do |order| %>
              <tr>
                <td><%= link_to order.project.name, project_path(order.project) %></td>
                <td><%= link_to order.no, manage_order_path(order), 'data-toggle' => "modal", 'data-target' => "#global-modal"%></td>
                <td><%= order.user&.name %></td>
                <td><%= order.project&.owner&.name %></td>
                <td><%= simple_time order.created_at %></td>
                <td>
                  <%= link_to t('sections.audits.approve'), success_audit_path(order, type: order.class.name), class: 'btn btn-success btn-xs', data: {confirm: t('sections.audits.confirm_approve')} %>
                  <%= link_to t('sections.audits.reject'), failed_notice_audit_path(order, type: order.class.name), 'data-toggle' => "modal", 'data-target' => "#global-modal", class: 'btn btn-danger btn-xs' %>
                </td>
              </tr>
              <tr></tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" align="center"><%= t('sections.audits.none') %></td>
            </tr>
          <% end %>

        </table>
      </div>
      <!-- /.box-body -->
      <div class="box-footer clearfix">
        <div class="pull-right pagination-sm no-margin">
          <%= paginate @orders%>
        </div>
      </div>
    </div>
    <!-- /.box -->
  </div>
</div>
