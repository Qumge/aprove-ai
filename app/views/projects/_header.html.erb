<% content_for :content_header do %>
  <h1>
    <%= t('projects.title') %>
    <small><%= @project.present? ? @project.name : get_title(params) %></small>

  </h1>
  <ol class="breadcrumb">
    <li>
      <%=link_to projects_path do %>
        <%= ui_icon 'layout-dashboard' %> <%= t('projects.title') %>
      <% end %>
    </li>
    <li class="active"><%= get_title params %></li>
  </ol>
<% end %>
