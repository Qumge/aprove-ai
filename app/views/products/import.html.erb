<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
  <h4 class="modal-title" id="myModalLabel"><%= t('sections.forms.product.bulk_import') %></h4>
</div>
<%= form_tag(do_import_products_path, multipart: true) do %>
  <div class="modal-body">
    <ol>
      <table class="table table-condensed table-bordered">
        <thead>
        <th><%= t('sections.forms.product.code') %></th>
        <th><%= t('sections.forms.product.name') %></th>
        <th><%= t('sections.forms.product.model') %></th>
        <th><%= t('sections.forms.product.category') %></th>
        <th><%= t('sections.products.columns.price') %></th>
        <th><%= t('sections.forms.product.unit') %></th>
        <th><%= t('sections.forms.product.brand') %></th>
        <th><%= t('sections.forms.product.dimensions') %></th>
        <th><%= t('sections.forms.product.market_price') %></th>
        <th><%= t('sections.forms.product.acquisition_price') %></th>
        <th><%= t('sections.forms.product.freight') %></th>
        <th><%= t('sections.forms.product.color') %></th>
        <th><%= t('sections.forms.product.notes') %></th>
        </thead>
        <tbody>
        <% 4.times do %><td><%= t('sections.forms.product.required') %></td><% end %>
        <% 9.times do %><td><%= t('sections.forms.product.optional') %></td><% end %>
        </tbody>
      </table>

      <ul>
        <li><%= t('sections.forms.product.import_layout') %></li>
        <li><%= t('sections.forms.product.import_category') %></li>
        <li><%= t('sections.forms.product.import_code') %></li>
      </ul>
    </ol>

    <p style="padding:50px"><%= file_field_tag :file, accept: 'application/vnd.ms-excel, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' %></p>
  </div>

  <div class="modal-footer">
    <%= submit_tag t('common.save'), class: 'btn btn-primary', data: { disable_with: t('common.saving') } %>
    <button type="button" class="btn btn-default" data-dismiss="modal"><%= t('common.back') %></button>
  </div>
<% end %>
