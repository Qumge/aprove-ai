<div class="input-group input-group-sm">

  <div class="col-md-3">
    <div class="input-group" style="width:100%">
      <div class="input-group-addon">
        <%= ui_icon 'calendar-days' %>
      </div>
      <input type="text" class="form-control" id="date_range" name="date_range" value="<%= params[:date_range] %>">
    </div>
  </div>


    <div class="col-md-3">
      <%= select_tag :model_type, options_for_select(localized_options(Attachment.model_types, 'sections.files.types'), params[:model_type]), include_blank: t('sections.files.type'), class: 'form-control select2' %>
    </div>
  <div class="col-md-3">
    <div class="input-group" style="width:100%">
      <input type="text" class="form-control" id="table_search" name="table_search" value="<%= params[:table_search] %>" placeholder="<%= t('sections.files.search') %>">
    </div>
  </div>

  <div class="input-group-btn">
    <button type="submit" class="btn btn-default icon-button" title="<%= t('common.search') %>"><%= ui_icon 'search' %></button>
  </div>
</div>
<script type="text/javascript">
    $(function(){
        moment.locale('<%= I18n.locale.to_s.downcase %>');
        $('#date_range').daterangepicker({
            autoclose: true,
            language: '<%= I18n.locale.to_s.downcase %>',
            locale: {
                format: "YYYY-MM-DD", //设置显示格式
                applyLabel: '<%= j t('common.confirm') %>',
                cancelLabel: '<%= j t('common.cancel') %>',
                customRangeLabel: '<%= j t('common.custom_range') %>',
                daysOfWeek: <%= raw I18n.t('date.abbr_day_names').to_json %>,
                monthNames: <%= raw I18n.t('date.month_names').compact.to_json %>,
                firstDay: 1
            },
        });
        $('.select2').select2();
    })
</script>
