
  <div class="box box-danger">
    <div class="box-header with-border">
      <h3 class="box-title"><%= t('sections.reports.order') %>
        <% if can? :orders, :record_reports %>
        <small><%= link_to t('common.more'), orders_record_reports_path, class: 'font-a label bg-green' %></small>
        <% end %>
      </h3>

      <div class="box-tools pull-right">
        <button type="button" class="btn btn-box-tool icon-button" data-widget="collapse" title="<%= t('common.close') %>"><%= ui_icon 'minus' %>
        </button>
        <button type="button" class="btn btn-box-tool icon-button" data-widget="remove" title="<%= t('common.close') %>"><%= ui_icon 'x' %></button>
      </div>
    </div>
    <div class="box-body">
      <canvas id="orders_pie" style="height:250px"></canvas>
    </div>
    <!-- /.box-body -->
  </div>

<script type="text/javascript">
  $(function(){
      myPieChat('orders_pie', <%= raw @orders_pie_labels %>, <%= raw @orders_pie_data %>);
  });
</script>
