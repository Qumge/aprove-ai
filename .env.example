# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=aprove_ai_development
POSTGRES_TEST_DB=aprove_ai_test

# HTTPS is enabled by default in production.
FORCE_SSL=true

# Demo seed account. Required when running db:seed in production.
APROVE_DEMO_PASSWORD=

# Upload storage: local or r2
UPLOAD_STORAGE=local

# Cloudflare R2 (set UPLOAD_STORAGE=r2 in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public bucket or custom-domain base URL. Private buckets use signed download URLs.
R2_PUBLIC_URL=

# SMTP (optional)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_STARTTLS=true
MAILER_FROM=no-reply@example.com

# Submail SMS (optional)
SUBMAIL_APP_ID=
SUBMAIL_APP_KEY=
SUBMAIL_TEMPLATE_ID=

# Error notifications (optional, comma-separated recipients)
EXCEPTION_RECIPIENTS=
EXCEPTION_SENDER=errors@example.com
